{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug hello host (Windows, gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/win-ucrt64-debug/bin/srsp_hello_host.exe",
      "args": [
        "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/win-ucrt64-debug/plugins/org.srsp.examples.hello/bin/srsp_hello.dll"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "externalConsole": false
    },
    {
      "name": "Debug srsp-cli (inproc)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/win-ucrt64-debug/bin/srsp-cli.exe",
      "args": [
        "demo",
        "--transport", "inproc",
        "--plugin",
        "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/win-ucrt64-debug/plugins/org.srsp.examples.hello/bin/srsp_hello.dll"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "externalConsole": false
    },
    {
      "name": "Debug srsp-cli (sidecar)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/win-ucrt64-debug/bin/srsp-cli.exe",
      "args": [
        "demo",
        "--transport", "sidecar",
        "--sidecar-exe",
        "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/win-ucrt64-debug/bin/srsp-sidecar.exe",
        "--plugin",
        "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/win-ucrt64-debug/plugins/org.srsp.examples.hello/bin/srsp_hello.dll"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "externalConsole": false
    },
    {
      "name": "Debug test_plugin_host (unit)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/win-ucrt64-debug/bin/test_plugin_host.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        },
        {
          "name": "SRSP_TEST_PLUGIN",
          "value": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/win-ucrt64-debug/plugins/org.srsp.examples.hello/bin/srsp_hello.dll"
        }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "externalConsole": false
    },
    {
      "name": "Debug hello host (Linux, gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/linux-gcc-debug/bin/srsp_hello_host",
      "args": [
        "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/linux-gcc-debug/plugins/org.srsp.examples.hello/bin/srsp_hello.so"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "externalConsole": false
    }
  ]
}
