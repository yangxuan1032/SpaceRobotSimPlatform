{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "${input:preset}"],
      "windows": {
        "command": "C:/msys64/ucrt64/bin/cmake.exe"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "CMake: build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "${input:preset}"],
      "windows": {
        "command": "C:/msys64/ucrt64/bin/cmake.exe"
      },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "CMake: test",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "${input:preset}", "--output-on-failure"],
      "windows": {
        "command": "C:/msys64/ucrt64/bin/ctest.exe"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Demo: hello plugin (Windows)",
      "type": "shell",
      "command": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/bin/srsp_hello_host.exe",
      "args": [
        "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/plugins/org.srsp.examples.hello/bin/srsp_hello.dll"
      ],
      "windows": {
        "command": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/bin/srsp_hello_host.exe"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "preset",
      "type": "pickString",
      "description": "CMake preset",
      "options": [
        "win-ucrt64-debug",
        "win-ucrt64-release",
        "linux-gcc-debug",
        "linux-gcc-release",
        "linux-clang-asan"
      ],
      "default": "win-ucrt64-debug"
    }
  ]
}
