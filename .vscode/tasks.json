{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "${input:preset}"],
      "windows": { "command": "C:/msys64/ucrt64/bin/cmake.exe" },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "CMake: build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "${input:preset}"],
      "windows": { "command": "C:/msys64/ucrt64/bin/cmake.exe" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "CMake: test",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "${input:preset}", "--output-on-failure"],
      "windows": { "command": "C:/msys64/ucrt64/bin/ctest.exe" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Docs: check (json/yaml/links)",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/tests/docs/check_docs.py"],
      "windows": {
        "command": "C:/msys64/ucrt64/bin/python.exe",
        "args": ["${workspaceFolder}/tests/docs/check_docs.py"]
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Demo: hello plugin",
      "type": "shell",
      "command": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/bin/srsp_hello_host",
      "args": [
        "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/plugins/org.srsp.examples.hello/bin/srsp_hello.so"
      ],
      "windows": {
        "command": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/bin/srsp_hello_host.exe",
        "args": [
          "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/plugins/org.srsp.examples.hello/bin/srsp_hello.dll"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Demo: srsp-cli (inproc)",
      "type": "shell",
      "command": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/bin/srsp-cli",
      "args": [
        "demo",
        "--transport", "inproc",
        "--plugin",
        "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/plugins/org.srsp.examples.hello/bin/srsp_hello.so"
      ],
      "windows": {
        "command": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/bin/srsp-cli.exe",
        "args": [
          "demo",
          "--transport", "inproc",
          "--plugin",
          "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/plugins/org.srsp.examples.hello/bin/srsp_hello.dll"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Demo: srsp-cli (sidecar)",
      "type": "shell",
      "command": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/bin/srsp-cli",
      "args": [
        "demo",
        "--transport", "sidecar",
        "--sidecar-exe",
        "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/bin/srsp-sidecar",
        "--plugin",
        "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/plugins/org.srsp.examples.hello/bin/srsp_hello.so"
      ],
      "windows": {
        "command": "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/bin/srsp-cli.exe",
        "args": [
          "demo",
          "--transport", "sidecar",
          "--sidecar-exe",
          "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/bin/srsp-sidecar.exe",
          "--plugin",
          "${workspaceFolder}/${env:SRSP_AI_MODEL}/Temp/build/${input:preset}/plugins/org.srsp.examples.hello/bin/srsp_hello.dll"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Format: clang-format (C/C++)",
      "type": "shell",
      "command": "clang-format",
      "args": [
        "-i",
        "src/**/*.cpp", "src/**/*.hpp",
        "apps/**/*.cpp",
        "tests/**/*.cpp",
        "examples/**/*.cpp"
      ],
      "windows": { "command": "C:/msys64/ucrt64/bin/clang-format.exe" },
      "problemMatcher": [],
      "group": "none"
    },
    {
      "label": "SRSP: build + test (dev loop)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "${input:preset}"],
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-Command",
          "C:/msys64/ucrt64/bin/cmake.exe --build --preset ${input:preset}; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; C:/msys64/ucrt64/bin/ctest.exe --preset ${input:preset} --output-on-failure"
        ]
      },
      "problemMatcher": ["$gcc"],
      "group": "test",
      "detail": "Build then run the suite; use this as the one-key progress check"
    },
    {
      "label": "SRSP: bench dynamics",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "${input:preset}", "--target", "bench_dynamics"],
      "windows": { "command": "C:/msys64/ucrt64/bin/cmake.exe" },
      "problemMatcher": ["$gcc"],
      "detail": "Build the dynamics benchmark (run the binary from the build bin dir)"
    },
    {
      "label": "SRSP: studio (RHI viewport)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "${input:preset}", "--target", "srsp_studio"],
      "windows": { "command": "C:/msys64/ucrt64/bin/cmake.exe" },
      "problemMatcher": ["$gcc"],
      "detail": "Build the studio; run it with --renderer rhi to use D3D11"
    },
    {
      "label": "SRSP: soak (1 minute smoke)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-File", "${workspaceFolder}/tools/stress/soak.ps1",
        "-Minutes", "1", "-IntervalSec", "10", "-Workload", "record"
      ],
      "windows": { "command": "pwsh" },
      "problemMatcher": [],
      "detail": "One-minute record soak; raise -Minutes for a long run"
    },
    {
      "label": "SRSP: visual check (user inspection)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tools/visual/VisualCheck.ps1"
      ],
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "detail": "Renders the Qt and RHI reference scene, opens the PNGs for a human look"
    }
  ],
  "inputs": [
    {
      "id": "preset",
      "type": "pickString",
      "description": "CMake preset",
      "options": [
        "win-ucrt64-debug",
        "win-ucrt64-release",
        "win-ucrt64-clang-debug",
        "win-clang64-debug",
        "win-msvc-debug",
        "linux-gcc-debug",
        "linux-gcc-release",
        "linux-clang-asan"
      ],
      "default": "win-ucrt64-debug"
    }
  ]
}
