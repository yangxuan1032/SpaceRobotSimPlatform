{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srsp.local/schema/plugin-manifest.schema.json",
  "title": "SRSP plugin manifest",
  "description": "Contract for plugin.json. See docs/02-plugin-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "api",
    "kind",
    "transport",
    "capabilities",
    "platforms"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "srsp.plugin/1" },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "api": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "kind": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "model",
          "dynamics",
          "environment",
          "sensor",
          "renderer",
          "controller",
          "io",
          "ui",
          "script"
        ]
      }
    },
    "description": { "type": "string", "maxLength": 4096 },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "contact": { "type": "string" }
      }
    },
    "license": { "type": "string" },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["inproc", "sidecar"] },
        "library": {
          "description": "Platform tag to relative library path (inproc only). Tags are either legacy 'os-arch' (toolchain-agnostic, kept for compatibility) or 'os-arch-toolchain' (preferred). Resolution: the loader picks the most specific matching tag (os-arch-toolchain first), then falls back to the bare os-arch tag. Toolchain-specific binaries are required because MSVC and MinGW C++ runtime dependencies are incompatible.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "windows-x86_64",
              "windows-aarch64",
              "linux-x86_64",
              "linux-aarch64",
              "macos-aarch64",
              "windows-x86_64-ucrt64",
              "windows-x86_64-msvc",
              "windows-x86_64-clang-cl",
              "linux-x86_64-gcc",
              "linux-x86_64-clang",
              "linux-aarch64-gcc",
              "macos-aarch64-apple-clang"
            ]
          },
          "additionalProperties": { "type": "string" }
        },
        "symbol": { "type": "string", "default": "srsp_plugin_query" },
        "command": {
          "description": "Sidecar command line; supports ${ENDPOINT}, ${TOKEN}, ${SHM}.",
          "type": "string"
        },
        "working_dir": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "inproc" } } },
          "then": { "required": ["library"] }
        },
        {
          "if": { "properties": { "type": { "const": "sidecar" } } },
          "then": { "required": ["command"] }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "alias"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^srsp\\.[a-z]+/[a-z_]+$"
          },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 32
          },
          "schema_hash": { "type": "string" }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "optional_requires": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "windows-x86_64",
          "windows-aarch64",
          "linux-x86_64",
          "linux-aarch64"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "config_schema": { "type": "string" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "init_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "thread_safe": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
